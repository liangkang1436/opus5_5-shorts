{
  "name": "opus5_5-shorts",
  "private": true,
  "version": "0.1.0",
  "description": "\u786c\u6838\u79d1\u666e\u77ed\u89c6\u9891 SaaS \u2014 Knife 1: make + render workers",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "pnpm -r run build",
    "make": "pnpm --filter make-worker start",
    "render": "pnpm --filter render-worker start",
    "typecheck": "pnpm -r run typecheck",
    "prepare": "pnpm --filter @opus5_5/shared build && pnpm --filter @opus5_5/pipeline build"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
